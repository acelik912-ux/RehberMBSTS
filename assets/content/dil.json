{"b":[{"id":"A","t":"A · En çok kullanılan cümleler","d":"Her grup tek bir hikâye: sahneler arka arkaya gelir, cümleleri sahne sırasıyla öğren."},{"id":"B","t":"B · En çok kullanılan kelimeler","d":"Bağlaçlar, ekler, zamirler, fiiller ve sık kelimeler; hepsi üç dilde alt alta."}],"g":[{"id":"a1","b":"A","t":"Saraybosna'ya iniş","ic":"🛬","s":"Ayşe uçaktan iniyor: pasaport, bavul, taksi, otel. Hikâye bu sırayla ilerler.","c":[{"id":"a1-1","e":"🛬","t":"Merhaba, ben Ayşe.","bs":"Zdravo, ja sam Ayša.","bo":"zdravo, ya sam ayşa","en":"Hello, I'm Ayşe.","eo":"helo, aym ayşe","ar":"مَرْحَبًا، أَنَا عَائِشَة.","ao":"merhaben, enâ âişe","k":"Uçaktan iner inmez gülümseyen biri el sallıyor: \"merhaba, ben…\"."},{"id":"a1-2","e":"🛂","t":"Pasaportum burada.","bs":"Ovdje je moj pasoš.","bo":"ovdye ye moy pasoş","en":"Here is my passport.","eo":"hiır iz may paspört","ar":"هٰذَا جَوَازُ سَفَرِي.","ao":"hâzâ cevâzü seferî","k":"Memur masasında pasaportu uzatıyorsun: \"burada\"."},{"id":"a1-3","e":"🧳","t":"Bavulum nerede?","bs":"Gdje je moj kofer?","bo":"gdye ye moy kofer","en":"Where is my suitcase?","eo":"ver iz may sutkeys","ar":"أَيْنَ حَقِيبَتِي؟","ao":"eyne hakîbetî","k":"Bant dönüyor, bavul yok: gözün her yerde \"nerede?\"."},{"id":"a1-4","e":"🚕","t":"Taksiye ihtiyacım var.","bs":"Treba mi taksi.","bo":"treba mi taksi","en":"I need a taxi.","eo":"ay nid ey teksi","ar":"أَحْتَاجُ إِلَى سَيَّارَةِ أُجْرَة.","ao":"ahtâcu ilâ seyyârati ucra","k":"Bavulla çıkışta elini kaldırıyorsun, sarı taksi duruyor."},{"id":"a1-5","e":"🏨","t":"Otele gidiyorum.","bs":"Idem u hotel.","bo":"idem u hotel","en":"I'm going to the hotel.","eo":"aym going tu dı hotel","ar":"أَنَا ذَاهِبَةٌ إِلَى الْفُنْدُقِ.","ao":"enâ zâhibetun ilâ'l-funduk","k":"Taksi şoförüne yönünü söylüyorsun: otel."},{"id":"a1-6","e":"🛏️","t":"Rezervasyonum var.","bs":"Imam rezervaciju.","bo":"imam rezervatsiyu","en":"I have a reservation.","eo":"ay hev ey rezırveyşın","ar":"عِنْدِي حَجْزٌ.","ao":"indî hacz","k":"Resepsiyonda kâğıdı gösteriyorsun: oda hazır."}]},{"id":"a2","b":"A","t":"Otelde sabah","ic":"🌅","s":"Ayşe uyanıyor, kahvaltıya iniyor, çay-kahve sipariş ediyor ve hesabı istiyor.","c":[{"id":"a2-1","e":"🌅","t":"Günaydın!","bs":"Dobro jutro!","bo":"dobro yutro","en":"Good morning!","eo":"gud morning","ar":"صَبَاحُ الْخَيْرِ!","ao":"sabâhu'l-hayr","k":"Perdeyi açıyorsun: güneş doğuyor."},{"id":"a2-2","e":"🍳","t":"Kahvaltı ne zaman?","bs":"Kada je doručak?","bo":"kada ye doruçak","en":"When is breakfast?","eo":"ven iz brekfıst","ar":"مَتَى الْفَطُورُ؟","ao":"metâ'l-futûr","k":"Asansörde resepsiyonistle karşılaşıyorsun, karnın gurulduyor."},{"id":"a2-3","e":"☕","t":"Bir çay ve bir kahve lütfen.","bs":"Jedan čaj i jednu kafu, molim.","bo":"yedan çay i yednu kafu molim","en":"A tea and a coffee, please.","eo":"ey ti end ey kofi pliz","ar":"شَايٌ وَقَهْوَةٌ مِنْ فَضْلِكَ.","ao":"şâyun ve kahvetun min fadlik","k":"Garson masaya iki fincan getiriyor."},{"id":"a2-4","e":"🥐","t":"Bu çok lezzetli.","bs":"Ovo je jako ukusno.","bo":"ovo ye yako ukusno","en":"This is very delicious.","eo":"dis iz veri dilişıs","ar":"هٰذَا لَذِيذٌ جِدًّا.","ao":"hâzâ lezîzun ciddan","k":"Kruvasanı ısırıyorsun: gözlerin kapanıyor."},{"id":"a2-5","e":"💧","t":"Biraz su alabilir miyim?","bs":"Mogu li dobiti malo vode?","bo":"mogu li dobiti malo vode","en":"Can I have some water?","eo":"ken ay hev sam vorır","ar":"هَلْ يُمْكِنُنِي أَنْ آخُذَ مَاءً؟","ao":"hel yumkinunî en âhuze mâen","k":"Bardak boş kalmış, elini kaldırıp istiyorsun."},{"id":"a2-6","e":"🧾","t":"Hesap lütfen.","bs":"Račun, molim.","bo":"raçun molim","en":"The bill, please.","eo":"dı bil pliz","ar":"الْحِسَابُ مِنْ فَضْلِكَ.","ao":"el-hısâbu min fadlik","k":"Garsona havada yazı yazar gibi işaret ediyorsun."}]},{"id":"a3","b":"A","t":"Çarşıda yol ve pazarlık","ic":"🛍️","s":"Ayşe çarşıya çıkıyor, kayboluyor, yol soruyor, alışveriş yapıp pazarlık ediyor.","c":[{"id":"a3-1","e":"🗺️","t":"Kayboldum.","bs":"Izgubila sam se.","bo":"izgubila sam se","en":"I'm lost.","eo":"aym lost","ar":"لَقَدْ تُهْتُ.","ao":"lekad tuhtu","k":"Haritan ters dönmüş, dar sokakta duruyorsun."},{"id":"a3-2","e":"📍","t":"Çarşı nerede?","bs":"Gdje je čaršija?","bo":"gdye ye çarşiya","en":"Where is the bazaar?","eo":"ver iz dı bazaar","ar":"أَيْنَ السُّوقُ؟","ao":"eyne's-sûk","k":"Yaşlı bir amcaya sorarsın; elinde simit var."},{"id":"a3-3","e":"➡️","t":"Düz git, sonra sağa dön.","bs":"Idite pravo, pa skrenite desno.","bo":"idite pravo pa skrenite desno","en":"Go straight, then turn right.","eo":"go streyt den törn rayt","ar":"اِذْهَبْ مُبَاشَرَةً ثُمَّ انْعَطِفْ يَمِينًا.","ao":"izheb mübâşeraten summe in'atıf yemînen","k":"Amca parmağıyla düz çiziyor, sonra sağa kıvırıyor."},{"id":"a3-4","e":"🛍️","t":"Bunu istiyorum.","bs":"Želim ovo.","bo":"jelim ovo","en":"I want this.","eo":"ay vont dis","ar":"أُرِيدُ هٰذَا.","ao":"urîdu hâzâ","k":"Vitrinde bakır cezveyi gösteriyorsun."},{"id":"a3-5","e":"💰","t":"Ne kadar?","bs":"Koliko košta?","bo":"koliko koşta","en":"How much is it?","eo":"hav maç iz it","ar":"بِكَمْ هٰذَا؟","ao":"bikem hâzâ","k":"Satıcı etiketi çeviriyor: rakamlar."},{"id":"a3-6","e":"🏷️","t":"Çok pahalı! Biraz indirim yapar mısınız?","bs":"Preskupo je! Možete li malo spustiti cijenu?","bo":"preskupo ye! mojete li malo spustiti tsiyenu","en":"It's too expensive! Can you lower the price a bit?","eo":"itsi tu ikspensiv! ken yu lovır dı prays ey bit","ar":"غَالٍ جِدًّا! هَلْ تُخَفِّضُ السِّعْرَ قَلِيلًا؟","ao":"gâlin ciddan! hel tuhaffidu's-si'ra kalîlen","k":"Başını sallıyor, parmaklarınla \"azıcık\" işareti yapıyorsun."}]},{"id":"a4","b":"A","t":"Yeni tanıdıklar","ic":"🤝","s":"Ayşe çay bahçesinde biriyle tanışıyor ve sohbet ediyor.","c":[{"id":"a4-1","e":"🤝","t":"Tanıştığımıza memnun oldum.","bs":"Drago mi je.","bo":"drago mi ye","en":"Nice to meet you.","eo":"nays tu mit yu","ar":"تَشَرَّفْنَا.","ao":"teşerrafnâ","k":"Çay bahçesinde el sıkışıyorsunuz."},{"id":"a4-2","e":"🌍","t":"Nerelisin?","bs":"Odakle si?","bo":"odakle si","en":"Where are you from?","eo":"ver ar yu from","ar":"مِنْ أَيْنَ أَنْتَ؟","ao":"min eyne ente","k":"Dünya haritasında parmağın geziniyor."},{"id":"a4-3","e":"🇹🇷","t":"Ben Türkiye'denim.","bs":"Ja sam iz Turske.","bo":"ya sam iz turske","en":"I'm from Turkey.","eo":"aym from törki","ar":"أَنَا مِنْ تُرْكِيَا.","ao":"enâ min Türkiyâ","k":"Parmağın Türkiye'nin üzerinde duruyor."},{"id":"a4-4","e":"🗣️","t":"Biraz konuşuyorum. Daha yavaş konuşur musunuz?","bs":"Govorim malo. Možete li govoriti sporije?","bo":"govorim malo. mojete li govoriti sporiye","en":"I speak a little. Could you speak more slowly?","eo":"ay spik ey litıl. kud yu spik mor slovli","ar":"أَتَكَلَّمُ قَلِيلًا. هَلْ تَتَكَلَّمُ بِبُطْءٍ؟","ao":"etekellemu kalîlen. hel tetekellemu bi-butın","k":"Karşındaki hızlı konuşuyor; sen elinle \"yavaş\" diyorsun."},{"id":"a4-5","e":"🌆","t":"Çok güzel bir şehir.","bs":"Veoma lijep grad.","bo":"veoma liyep grad","en":"It's a beautiful city.","eo":"itsi ey byutifıl siti","ar":"مَدِينَةٌ جَمِيلَةٌ جِدًّا.","ao":"medînetun cemîletun ciddan","k":"Köprüden akşam ışıklarına bakıyorsunuz."},{"id":"a4-6","e":"👋","t":"Yarın görüşürüz.","bs":"Vidimo se sutra.","bo":"vidimo se sutra","en":"See you tomorrow.","eo":"si yu tumorov","ar":"أَرَاكَ غَدًا.","ao":"erâke gaden","k":"Ayrılırken el sallıyorsun, ay yükseliyor."}]},{"id":"a5","b":"A","t":"Camide ve dualarda","ic":"🕌","s":"Ayşe ezan sesiyle camiye yürüyor, abdest alıyor, dualaşıyor.","c":[{"id":"a5-1","e":"🕌","t":"Cami nerede?","bs":"Gdje je džamija?","bo":"gdye ye camiya","en":"Where is the mosque?","eo":"ver iz dı mosk","ar":"أَيْنَ الْمَسْجِدُ؟","ao":"eyne'l-mescid","k":"Uzaktan ezan duyuyorsun, minareye bakıyorsun."},{"id":"a5-2","e":"🚰","t":"Abdest almak istiyorum.","bs":"Želim uzeti abdest.","bo":"jelim uzeti abdest","en":"I want to perform ablution.","eo":"ay vont tu pörform ablüşın","ar":"أُرِيدُ أَنْ أَتَوَضَّأَ.","ao":"urîdu en etevadda'e","k":"Şadırvanın başında kollarını sıvıyorsun."},{"id":"a5-3","e":"🕰️","t":"Namaz vakti ne zaman?","bs":"Kada je vrijeme namaza?","bo":"kada ye vriyeme namaza","en":"When is prayer time?","eo":"ven iz prayır taym","ar":"مَتَى وَقْتُ الصَّلَاةِ؟","ao":"metâ vaktu's-salât","k":"Duvardaki vakit tablosuna parmak uzatıyorsun."},{"id":"a5-4","e":"🤲","t":"Allah kabul etsin.","bs":"Neka Allah primi.","bo":"neka allah primi","en":"May God accept it.","eo":"mey god aksept it","ar":"تَقَبَّلَ اللّٰهُ.","ao":"tekabbele'llâh","k":"Namaz sonrası yan yana eller açılıyor."},{"id":"a5-5","e":"🌙","t":"Allah razı olsun.","bs":"Allah razi bio.","bo":"allah razi bio","en":"May God be pleased with you.","eo":"mey god bi plizd vit yu","ar":"رَضِيَ اللّٰهُ عَنْكَ.","ao":"radıyallâhu anke","k":"Sana yer açan cemaate hilal gibi gülümsüyorsun."},{"id":"a5-6","e":"🕊️","t":"Ramazanın mübarek olsun.","bs":"Ramazan mubarek.","bo":"ramazan mubarek","en":"Blessed Ramadan.","eo":"blest ramadan","ar":"رَمَضَانُ مُبَارَكٌ.","ao":"ramadânu mübârek","k":"Hilal çıkıyor, mahyalar yanıyor."}]},{"id":"b1","b":"B","t":"Bağlaçlar (yol tabelaları)","ic":"🔗","s":"Her bağlaç bir yol tabelası: ➕ ekle, ↩️ karşıt, 🔙 neden, 🔀 seçenek, ❓ şart.","c":[{"id":"b1-1","e":"➕","t":"ve","bs":"i","bo":"i","en":"and","eo":"end","ar":"وَ","ao":"ve","k":"Artı işareti: iki şeyi yan yana tutar."},{"id":"b1-2","e":"↩️","t":"ama / fakat","bs":"ali","bo":"ali","en":"but","eo":"bat","ar":"لٰكِنْ","ao":"lâkin","k":"Yolda geri dönüş tabelası: düşünce ters döner."},{"id":"b1-3","e":"🔙","t":"çünkü","bs":"jer","bo":"yer","en":"because","eo":"bikoz","ar":"لِأَنَّ","ao":"li-enne","k":"Okun geriye bakıyor: sebebe gider."},{"id":"b1-4","e":"🔀","t":"veya","bs":"ili","bo":"ili","en":"or","eo":"or","ar":"أَوْ","ao":"ev","k":"Yol ikiye ayrılıyor: ya sol ya sağ."},{"id":"b1-5","e":"❓","t":"eğer","bs":"ako","bo":"ako","en":"if","eo":"if","ar":"إِذَا","ao":"izâ","k":"Kapı kilitli: şart anahtarı \"eğer\"."},{"id":"b1-6","e":"📌","t":"ki / diye (söylemek için)","bs":"da","bo":"da","en":"that","eo":"det","ar":"أَنَّ","ao":"enne","k":"\"Sana şunu söylüyorum ki…\" diyen ok."},{"id":"b1-7","e":"⏭️","t":"sonra","bs":"poslije","bo":"posliye","en":"after / then","eo":"after / den","ar":"بَعْدَ","ao":"ba'de","k":"Sıra bir sonraki kapıya geçer."},{"id":"b1-8","e":"⏮️","t":"önce","bs":"prije","bo":"priye","en":"before","eo":"bifor","ar":"قَبْلَ","ao":"kable","k":"Geri sarma düğmesi."},{"id":"b1-9","e":"🤝","t":"ile (birlikte)","bs":"sa","bo":"sa","en":"with","eo":"vit","ar":"مَعَ","ao":"me'a","k":"İki el sıkışır: yanında."},{"id":"b1-10","e":"🎁","t":"için","bs":"za","bo":"za","en":"for","eo":"for","ar":"لِـ","ao":"li-","k":"Hediye kutusu: birine \"için\"."},{"id":"b1-11","e":"🪞","t":"gibi","bs":"kao","bo":"kao","en":"like","eo":"layk","ar":"مِثْلَ","ao":"misle","k":"Aynada ikiz: gibi."},{"id":"b1-12","e":"💡","t":"yani","bs":"to jest","bo":"to yest","en":"that is","eo":"det iz","ar":"أَيْ","ao":"ey","k":"Ampul yanar: yani açıklıyorum."},{"id":"b1-13","e":"🎯","t":"hatta / bile","bs":"čak","bo":"çak","en":"even","eo":"ivın","ar":"حَتَّى","ao":"hattâ","k":"Hedefin ortası, hatta daha ötesi."},{"id":"b1-14","e":"⏳","t":"-ken / sırasında","bs":"dok","bo":"dok","en":"while","eo":"vayl","ar":"بَيْنَمَا","ao":"beynemâ","k":"İki iş aynı anda: biri akarken diğeri."},{"id":"b1-15","e":"🔔","t":"-dığında / olduğunda","bs":"kada","bo":"kada","en":"when","eo":"ven","ar":"عِنْدَمَا","ao":"indemâ","k":"Zil çalınca ne olur: -dığında."}]},{"id":"b2","b":"B","t":"Kelimeye gelen ekler","ic":"🧩","s":"Türkçedeki \"-ler, -de, -im, -di, -iyor, -me\" eklerinin üç dildeki karşılıkları. Ek = küçük yapboz parçası.","c":[{"id":"b2-1","e":"🧩","t":"Çokluk eki (-ler / -lar)","bs":"-i, -e, -ovi: grad → gradovi","bo":"-i, -e, -ovi: grad → gradovi","en":"-s / -es: book → books","eo":"-s / -es: buk → buks","ar":"-ات / -ون: مُعَلِّمٌ → مُعَلِّمُونَ","ao":"-ât / -ûn: muallim → muallimûn","k":"Tek kutu çoğalıp çok kutu oluyor: şehir → şehirler."},{"id":"b2-2","e":"🔎","t":"Belirlilik (… o kitap)","bs":"Yok: knjiga = kitap / o kitap","bo":"Yok: knyiga","e