\" = kaç: bi-kem = kaça?"},{"id":"ar-aliveris-2","e":"💧🙋","n":"أريد ماء","o":"urîdu mâ'en","t":"Su istiyorum","k":"\"Urîdu\" = irade: su iradem. \"Mâ\" = su."},{"id":"ar-aliveris-3","e":"🙏","n":"من فضلك","o":"min fadlik","t":"Lütfen","k":"\"Fadl\" = fazilet / lütuf: lütfen."},{"id":"ar-aliveris-4","e":"🙌","n":"شكرا","o":"şükran","t":"Teşekkürler","k":"\"Şükran\" = şükür."},{"id":"ar-aliveris-5","e":"😊","n":"عفوا","o":"afven","t":"Rica ederim / af","k":"\"Afv\" = af: affedersiniz, rica ederim."},{"id":"ar-aliveris-6","e":"😋","n":"هذا لذيذ","o":"hâzâ lezîz","t":"Bu lezzetli","k":"\"Lezîz\" = lezzetli: lezzet kökü."}]},{"id":"ar-yol","t":"Yol ve yardım","ic":"🧭","c":[{"id":"ar-yol-1","e":"📍❓","n":"أين المسجد؟","o":"eyne'l-mescid","t":"Cami nerede?","k":"\"Eyne\" = nerede, \"mescid\" = mescit."},{"id":"ar-yol-2","e":"➡️⬅️","n":"يمين، يسار","o":"yemîn, yesâr","t":"Sağ, sol","k":"\"Yemîn\" = yemin ettiğin sağ el."},{"id":"ar-yol-3","e":"⬆️","n":"مستقيم","o":"müstakîm","t":"Düz","k":"\"Müstakîm\" = doğru yol: sırât-ı müstakîm."},{"id":"ar-yol-4","e":"🆘","n":"ساعدني من فضلك","o":"sâ'idnî min fadlik","t":"Bana yardım et lütfen","k":"\"Sâ'id\" = yardım eden: saidnî = bana yardım et."},{"id":"ar-yol-5","e":"🤷","n":"لا أفهم","o":"lâ efhem","t":"Anlamıyorum","k":"\"Lâ\" = hayır, \"efhem\" = fehmetmek: anlamak."}]}]}]